{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocMitra",
  "version": "0.1.0",
  "identifier": "com.docmitra.app",
  "build": {
    "frontendDist": "../app",
    "beforeDevCommand": "",
    "beforeBuildCommand": "node build-ui.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DocMitra - Administrative Bento Workstation",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
